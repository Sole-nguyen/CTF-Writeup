# Leak data
indices0 = [0, 2, 4, 5, 8, 9, 10, 14, 15, 17, 20, 21, 22, 23, 24, 25, 27, 28, 29, 33, 34, 35, 39, 40, 41, 43, 45, 47, 49, 50, 52, 53, 54, 57, 58, 59, 60, 61, 62, 63, 65, 68, 71, 72, 76, 80, 82, 84, 85, 86, 87, 91, 94, 98, 100, 104, 105, 106, 107, 108, 112, 113, 114, 116, 117, 118, 121, 122, 126, 127, 128, 129, 136, 137, 138, 139, 141, 142, 148, 150, 153, 154, 157, 158, 162, 166, 167, 169, 171, 172, 180, 185, 192, 195, 196, 197, 199, 201, 202, 203, 204, 207, 210, 212, 214, 216, 219, 220, 221, 222, 223, 225, 228, 230, 232, 235, 236, 237, 240, 243, 244, 245, 246, 247, 250, 251, 253, 254]
