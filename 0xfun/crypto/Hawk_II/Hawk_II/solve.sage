leak_vec0 = K(z^254 + 4*z^253 - z^251 + 2*z^250 + 3*z^246 + z^244 + z^243 - 2*z^240 - z^237 + 2*z^236 + 2*z^235 + 3*z^232 - z^230 - z^228 + 3*z^223 + z^222 + z^221 - 2*z^220 + z^219 - z^216 + 6*z^214 - 2*z^212 - 3*z^210 - 3*z^207 + z^204 + 3*z^203 - z^202 + 3*z^201 - 2*z^199 - 2*z^197 - 2*z^196 - 2*z^195 - 2*z^192 - 3*z^185 + 2*z^180 - 2*z^171 + z^169 + z^167 - z^166 - 3*z^162 + 2*z^158 + 3*z^154 - z^153 - 2*z^150 + z^148 - z^142 - 2*z^141 + 2*z^139 - 2*z^138 - 3*z^136 - 2*z^129 - z^128 + z^127 - z^126 + 3*z^122 - 3*z^118 + z^117 + z^116 + 2*z^114 - z^113 + 2*z^112 - 3*z^107 + z^106 + 3*z^105 - z^100 + z^98 - 3*z^94 + z^91 - z^87 - 4*z^86 + z^85 - z^84 + 2*z^82 + z^71 - z^68 + z^65 + 2*z^63 + z^62 - 3*z^61 - 2*z^60 - 3*z^58 + 2*z^57 + z^54 + z^53 + 4*z^52 + z^50 - z^49 + z^47 + 2*z^45 - z^43 + z^41 - z^40 - 7*z^39 - z^35 + 2*z^34 + 2*z^29 - 3*z^28 + z^25 - z^24 + 2*z^23 - 3*z^22 - z^21 + z^20 + z^17 + z^15 - z^14 - z^10 + 2*z^9 + z^8 - 3*z^5 - z^4 - 5*z^2)
leak_vec1 = K(2*z^255 + z^252 + 2*z^249 - z^248 + 2*z^242 - z^241 + 2*z^239 + 2*z^238 - 2*z^234 + z^233 + 3*z^231 + z^229 - 2*z^227 - z^226 - z^224 + 2*z^218 - z^217 + 3*z^215 - 2*z^213 + z^209 + z^206 - z^205 - 2*z^200 + z^198 + 4*z^194 - 2*z^193 + 3*z^191 - z^189 + 5*z^188 - 5*z^187 + 3*z^184 - 4*z^183 + 3*z^182 - z^181 + 4*z^179 + 3*z^178 - 3*z^176 + z^175 - z^174 + z^173 - z^168 - z^165 + z^164 - z^161 - 2*z^160 + 2*z^156 + z^155 + 4*z^152 - 4*z^151 + 4*z^149 - 2*z^147 + z^146 - z^145 - z^144 + z^143 - 2*z^140 + z^135 - 3*z^134 - 3*z^133 - z^132 + z^131 + 2*z^130 + z^125 - 3*z^124 - z^123 - 3*z^120 + z^119 - z^115 + 2*z^111 - 2*z^110 + z^109 + 4*z^103 - z^101 + 3*z^97 - 2*z^92 - 3*z^90 + z^89 + z^88 + 2*z^83 - 3*z^81 - 2*z^79 - 2*z^78 + 2*z^77 + z^75 + z^70 - z^69 + 2*z^67 - 2*z^66 - 3*z^64 - 5*z^56 + 2*z^55 + z^51 + z^48 - z^46 + 2*z^44 - z^42 + 3*z^38 + z^37 + z^32 + 4*z^31 + 2*z^30 - z^16 + z^12 + 2*z^11 - 2*z^6 + z)

# Strategy: Use the NTRU relation f*G - g*F = 1
# We know q00 = f*conj(f) + g*conj(g) from the public key
# We have partial knowledge of f and g

# Since we have half the coefficients of f and g,we can use lattice attack
# to recover the missing coefficients.

# Build a lattice where the secret key is a short vector
# We have the relation: q00 = f*bar(f) + g*bar(g), q10 = F*bar(f) + G*bar(g)

q00, q10, q11 = pk

# We know that f and g are small (coefficients from Discrete Gaussian with sigma=2)
# We can set up a lattice problem to find the missing coefficients

print("[+] Starting lattice attack to recover missing coefficients...")

# Extract known coefficients from leak vectors
known_f = [int(leak_vec0[i]) if i in indices0 else None for i in range(n)]
known_g = [int(leak_vec1[i]) if i in indices1 else None for i in range(n)]

