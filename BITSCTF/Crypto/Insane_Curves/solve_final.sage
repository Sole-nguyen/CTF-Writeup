#!/usr/bin/env sage

# Since p+1 is extremely smooth, and the Jacobian order is approximately (p+1)^2,
# the order should also be smooth. Let me compute candidate orders and try DLP.

p = 129403459552990578380563458675806698255602319995627987262273876063027199999999
f_coeffs = [87455262955769204408909693706467098277950190590892613056321965035180446006909, 12974562908961912291194866717212639606874236186841895510497190838007409517645, 11783716142539985302405554361639449205645147839326353007313482278494373873961, 55538572054380843320095276970494894739360361643073391911629387500799664701622, 124693689608554093001160935345506274464356592648782752624438608741195842443294, 52421364818382902628746436339763596377408277031987489475057857088827865195813, 50724784947260982182351215897978953782056750224573008740629192419901238915128]

Fp = GF(p)
R.<x> = PolynomialRing(Fp)
f = R(f_coeffs)

H = HyperellipticCurve(f)
J = H.jacobian()(Fp)

# Create points
G_u = R([95640493847532285274015733349271558012724241405617918614689663966283911276425, 1])
G_v = R([23400917335266251424562394829509514520732985938931801439527671091919836508525])
G = J([G_u, G_v])

Q_u = R([34277069903919260496311859860543966319397387795368332332841962946806971944007, 343503204040841221074922908076232301549085995886639625441980830955087919004, 1])
Q_v = R([102912018107558878490777762211244852581725648344091143891953689351031146217393, 65726604025436600725921245450121844689064814125373504369631968173219177046384])
Q = J([Q_u, Q_v])

print("[+] Points G and Q created")
print(f"[+] G = {G}")
print(f"[+] Q = {Q}")

# p+1 = 2^23 * 3^14 * 5^8 * 7^4 * 11^10 * 13^10 * 17^9 * 19^6 * 23^5 * 29 * 31^4
p_plus_1 = p + 1

print(f"\n[+] p+1 = {p_plus_1}")
print(f"[+] p+1 is highly smooth")

# For genus 2, #J(Fp) = (p+1)^2 + O(p^(3/2))
# Let's use (p+1)^2 as the base order and try multiples of small primes

base_order = p_plus_1^2

print(f"\n[+] Estimated Jacobian order ≈ (p+1)^2 = {base_order}")

# Since p+1 is so smooth, (p+1)^2 should also be smooth
# Let me try using this as the order for Pohlig-Hellman

print("\n[+] Attempting DLP with estimated smooth order...")

# Try with the smooth structure
# First check if Q is in the subgroup generated by G

# Try a few candidate orders close to base_order
for delta in [0, p_plus_1, -p_plus_1, 2*p_plus_1, -2*p_plus_1]:
    candidate_order = base_order + delta
    print(f"\n[+] Trying order = base_order + {delta}")
    
    # Check if both are in this subgroup
    if candidate_order * G == J(0):
        print(f"    G has order dividing {candidate_order}")
        if candidate_order * Q == J(0):
            print(f"    Q also has order dividing {candidate_order}")
            print(f"    Attempting DLP...")
            
            try:
                k = discrete_log(Q, G, ord=candidate_order, operation='+')
                print(f"\n[!!!] FOUND k = {k}")
                
                #Decrypt
                from Crypto.Cipher import AES
                from Crypto.Util.number import long_to_bytes
                import hashlib
                
                key = hashlib.sha256(long_to_bytes(int(k))).digest()[:16]
                enc_flag = bytes.fromhex("f6ca1f88bdb8e8dda17861b91704523f914564888c7138c24a3ab98902c10de5")
                cipher = AES.new(key, AES.MODE_ECB)
                flag = cipher.decrypt(enc_flag)
                
                print(f"\n[+] FLAG: {flag}")
                break
            except Exception as e:
                print(f"    DLP failed: {e}")
        else:
            print(f"    Q does not have order dividing {candidate_order}")
    else:
        print(f"    G does not have order dividing {candidate_order}")
        
print("\n[+] Script complete")
