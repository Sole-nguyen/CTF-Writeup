FROM golang:1.24 AS builder
FROM golang:1.21 AS builder

WORKDIR /app

# copy toàn bộ mã nguồn Go trong thư mục chall
COPY . .

# tải dependency
RUN go mod tidy

# build binary
RUN CGO_ENABLED=0 GOOS=linux go build -o chall .

# stage chạy
FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/chall .

EXPOSE 3000

CMD ["./chall"]

